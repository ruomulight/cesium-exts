{
  "name": "cesium-exts-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "dev:cesium-web": "turbo run dev --filter=cesium-web",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{js,ts,mjs,cjs,json,tsx,css,less,scss,vue,html,md}\"",
    "prepare": "husky || true"
  },
  "lint-staged": {
    "*.{js,ts,mjs,cjs,json,tsx,css,less,scss,vue,html,md}": [
      "prettier --write"
    ],
    "*.{js,ts,mjs,cjs,tsx}": [
      "pnpm exec eslint --fix"
    ]
  },
  "devDependencies": {
    "eslint": "^10.0.2",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "prettier": "^3.8.1",
    "turbo": "^2.7.5"
  },
  "packageManager": "pnpm@10.10.0",
  "engines": {
    "node": ">=22.18.0",
    "npm": ">=10.9.3",
    "pnpm": ">=10.10.0"
  }
}
