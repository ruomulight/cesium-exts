{
  "name": "vite-cesium-exts-dev",
  "version": "1.0.0",
  "description": "Vite 插件：为 cesium-exts 提供开发模式下的内存构建（GLSL 着色器、Web Worker）",
  "type": "module",
  "main": "src/index.ts",
  "module": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
