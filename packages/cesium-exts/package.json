{
  "name": "cesium-exts",
  "version": "1.0.0",
  "description": "Cesium-exts 扩展引擎核心库,基于 cesium v1.140.1开发",
  "type": "module",
  "main": "./index.ts",
  "module": "./index.ts",
  "types": "./index.ts",
  "exports": {
    ".": {
      "types": "./index.ts",
      "import": "./index.ts",
      "default": "./index.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "index.ts",
    "types"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint ."
  },
  "keywords": [
    "cesium",
    "engine",
    "3d"
  ],
  "author": "ruomulight",
  "license": "ISC",
  "peerDependencies": {
    "cesium": "catalog:cesium"
  },
  "devDependencies": {
    "@repo/config-eslint": "workspace:*",
    "eslint": "catalog:tooling",
    "tsdown": "catalog:tooling",
    "typescript": "catalog:tooling",
    "typescript-eslint": "catalog:eslint"
  }
}
