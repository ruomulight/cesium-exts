{
  "name": "vite-cesium-sandcastle",
  "version": "1.0.0",
  "description": "Vite 插件：Sandcastle iframe 运行时（占位符、bucket-client、Tweakpane）与 cesium-exts 源码直连",
  "type": "module",
  "main": "src/index.ts",
  "module": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    }
  },
  "scripts": {
    "lint": "eslint .",
    "check-types": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": [
    "vite",
    "plugin",
    "cesium",
    "sandcastle"
  ],
  "license": "ISC",
  "dependencies": {
    "fs-extra": "catalog:cesium-plugin"
  },
  "devDependencies": {
    "@repo/config-eslint": "workspace:*",
    "@repo/config-typescript": "workspace:*",
    "@types/fs-extra": "catalog:cesium-plugin",
    "@types/node": "catalog:tooling",
    "eslint": "catalog:tooling",
    "typescript": "catalog:tooling"
  },
  "peerDependencies": {
    "vite": "catalog:tooling"
  }
}
