{
  "compilerOptions": {
    "target": "ES2022", // 目标 ECMAScript 版本
    "useDefineForClassFields": true, // 使用符合标准的类字段定义
    "lib": ["ES2022", "DOM", "DOM.Iterable"], // 包含的库文件
    "module": "ESNext", // 指定生成的模块代码版本
    "types": ["vite/client"], // 指定包含的类型声明文件
    "skipLibCheck": true, // 跳过声明文件的类型检查

    /* 模块解析相关 */
    "moduleResolution": "bundler", // 模块解析策略（适用于 bundler）
    "allowImportingTsExtensions": true, // 允许导入以 .ts 结尾的文件
    "verbatimModuleSyntax": true, // 保持模块语法不被转换
    "moduleDetection": "force", // 强制 TS 将所有文件视为模块
    "composite": true, // 启用工程拆分，要求被引用
    "noEmit": false, // 关闭禁止输出，以便生成 .tsbuildinfo
    "emitDeclarationOnly": true, // 仅输出类型声明文件
    "jsx": "react-jsx", // 指定 JSX 代码生成方式

    /* 严格检查相关 */
    "strict": true, // 启用所有严格类型检查选项
    "noUnusedLocals": true, // 检查未使用的局部变量
    "noUnusedParameters": true, // 检查未使用的参数
    "erasableSyntaxOnly": true, // 仅使用可擦除的语法（TS 5.8+）
    "noFallthroughCasesInSwitch": true, // 防止 switch 穿透
    "noUncheckedSideEffectImports": true, // 检查无副作用导入的有效性

    "paths": {
      "@/*": ["./src/*"] // 路径别名映射
    }
  },
  "include": ["src", "types"] // 包含的文件目录
}
