# .npmrc — pnpm / npm 全局配置
# 此文件适用于整个 monorepo 中的所有子包

# 严格引擎检查：要求用户使用的 Node.js 版本必须满足 package.json 中的 engines 字段，
# 不匹配时拒绝安装，避免因 Node 版本过低/过高导致运行时问题
engine-strict=true

# 精确版本锁定：安装依赖时自动保存为精确版本号（如 1.2.3），
# 而非默认的 ^1.2.3 范围语义，防止 minor/patch 升级引入意外变更
save-exact=true

# 工作区链接深度：将所有 monorepo 内互相依赖的包直接链接到最深层的 node_modules，
# 消除幽灵依赖访问，确保每个包只能访问其显式声明的依赖
link-workspace-packages=deep

# 严格 peer 依赖检查：设为 false 表示 peer 依赖缺失时仅警告而不报错中断。
# 关闭是因为部分第三方库对 peer 版本范围声明过于严格，实际运行时兼容
strict-peer-dependencies=false

# 自动安装 peer 依赖：当某个依赖声明了 peer 但未在本项目中安装时，
# pnpm 会自动补全，省去手动排查 peer 缺失的错误
# 运行脚本前校验依赖：设为 install 表示执行 pnpm run/test 等脚本前，若 node_modules 与 lockfile 不同步则自动安装，
# 避免因依赖未同步（如切换分支、拉取代码后）导致的模块缺失报错
verify-deps-before-run=install